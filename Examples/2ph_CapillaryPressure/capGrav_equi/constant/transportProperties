FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Fluid and rock properties
// a: gas
// b: water

mu_a              mu_a [0 0 0 0 0 0 0] 1.76e-5;    // Pa.s

mu_b              mu_b [0 0 0 0 0 0 0] 1e-3;       // Pa.s

rho_a              rho_a [0 0 0 0 0 0 0] 1e0;      // kg/m3

rho_b              rho_b [0 0 0 0 0 0 0] 1e3;      // kg/m3

prst            prst [0 0 0 0 0 0 0] 0.5;          // [-]

// Gravity
g_vector        g_vector [0 0 0 0 0 0 0] (-9.81 0 0);

// Relative permeability model

relativePermeabilityModel CoreyBrooksExtd;

CoreyBrooks
{
  Sa_min    1e-3;
  Sb_min    1e-3;
  a_exp     3.0;
  b_exp     3.0;
  kra_max   1.0;
  krb_max   1.0;
}

CoreyBrooksExtd
{
  Sa_min    1e-3;
  Sb_min    1e-3;
  a_exp     3.0;
  b_exp     3.0;
  kra_max   1.0;
  krb_max   1.0;
}

// Foam model 

foamModel noFoam;

noFoam
{
  
}

// Capillary pressure model

capillaryPressureModel CoreyBrooksPC;

CoreyBrooksPC
{
  Spc_irr 0.0;
  Spc_max 1.0;
  pc0     1000.0;
  alpha   0.5;
}

// Surfactante concentration transport

surfactantTransportModel noSurfTransp;

noSurfTransp
{
  isothermModel noAdsorption;

  // Adorption isotherms
  noAdsorption
  {
  }
}

