FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Ua;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0]; 

internalField   uniform (0 0 0);

boundaryField
{
    cylinder_in
    {
        type            fixedValue;
        value           uniform (7e-5 7e-5 0);

        // type               calculated;
        // value              uniform (0 0 0);
    }

    cylinder_out
    {
        type            zeroGradient;
    }

    sidewalls
    {
        type            slip;
    }

    updownwalls
    {
        type            empty;
    }
}

