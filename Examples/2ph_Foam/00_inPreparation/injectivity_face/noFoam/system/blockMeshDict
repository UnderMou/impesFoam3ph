FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

r 1.0;
R 1000.0;
h 1.0;

Nx 50;
Ny 50;
Nz 1;

gx 300;

geometry
{
    cylinder_in
    {
        type   searchableCylinder;
        point1 (0 0 -1e3);
        point2 (0 0 1e3);
        radius $r;
    }

    cylinder_out
    {
        type   searchableCylinder;
        point1 (0 0 -1e3);
        point2 (0 0 1e3);
        radius $R;
    }
}

vertices
(   
    project ($r 0 0) (cylinder_in)               // 0
    project ($R 0 0) (cylinder_out)              // 1
    project (0 $R 0) (cylinder_out)              // 2
    project (0 $r 0) (cylinder_in)               // 3
    
    project ($r 0 $h) (cylinder_in)               // 4
    project ($R 0 $h) (cylinder_out)              // 5
    project (0 $R $h) (cylinder_out)              // 6
    project (0 $r $h) (cylinder_in)               // 7	
);

blocks
(   
	hex (0 1 2 3 4 5 6 7)		                  // cylinder
    ($Nx $Ny $Nz)
    edgeGrading
    (
        $gx $gx $gx $gx
        1 1 1 1
        1 1 1 1
    )	
);

edges
(
    project 0 3 (cylinder_in)
    project 4 7 (cylinder_in)
    project 1 2 (cylinder_out)
    project 5 6 (cylinder_out)
);

boundary
(
    cylinder_in
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }

    cylinder_out
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }

    sidewalls
    {
        type patch;
        faces
        (
            (0 1 5 4)
            (6 2 3 7)
        );
    }

    updownwalls
    {
        type empty;
        faces
        (
            (6 7 4 5)
            (3 2 1 0)
        );
    }
	
);

