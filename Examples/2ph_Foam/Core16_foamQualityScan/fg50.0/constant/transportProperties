FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

mu_a              mu_a [0 0 0 0 0 0 0] 2.112e-5;      // Pa.s

mu_b              mu_b [0 0 0 0 0 0 0] 5.0e-4;     // Pa.s

rho_a              rho_a [0 0 0 0 0 0 0] 1000.0;    // kg/m3

rho_b              rho_b [0 0 0 0 0 0 0] 1000.0;    // kg/m3

prst            prst [0 0 0 0 0 0 0] 0.25;        // []

// Relative permeability model

relativePermeabilityModel CoreyBrooks;

CoreyBrooks
{
  Sa_min    0.293;
  Sb_min    0.4;
  a_exp     0.96;
  b_exp     2.98;
  kra_max   0.04;
  krb_max   0.302;
}

// Foam model 

foamModel STARS;

STARS
{
  fmmob     269.342055;
  SF        0.43766393;
  sfbet     787.457944;
  fmcap     1.0;
  epcap     0.0;
  sigma_ba  1.0; 
}

