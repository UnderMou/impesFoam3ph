FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Fluid and rock properties
// a: gas
// b: water

mu_a              mu_a [0 0 0 0 0 0 0] 0.05e-3;     // Pa.s  Gas

mu_b              mu_b [0 0 0 0 0 0 0] 0.5e-3;      // Pa.s  Water 

mu_c              mu_c [0 0 0 0 0 0 0] 1.1e-3;      // Pa.s  Oil

rho_a              rho_a [0 0 0 0 0 0 0] 386.0;     // kg/m3

rho_b              rho_b [0 0 0 0 0 0 0] 1028.0;    // kg/m3

rho_c              rho_c [0 0 0 0 0 0 0] 750.0;     // kg/m3

prst            prst [0 0 0 0 0 0 0] 0.07;          // []

// Gravity
g_vector        g_vector [0 0 0 0 0 0 0] (0 -9.81 0);

// Relative permeability model

relativePermeabilityModel CoreyBrooksExtd;

CoreyBrooksExtd
{
  Sa_min    0.013;
  Sb_min    0.197;
  Sc_min    0.103;
  a_exp     5.2302441358286735;
  b_exp     1.9674471619548362;
  c_exp     3.328339335325447;
  kra_max   0.6476154287688796;
  krb_max   0.8439783032606722;
  krc_max   0.028708410437082624;
}

// Foam model 

foamModel STARS;
FshearActive false;
FsurfActive false;
FoilActive true;

STARS
{
  fmmob     50000.0;
  SF        0.215;
  sfbet     19950.0;
  fmcap     1.0e-4;
  epcap     1.321;
  sigma_ba  0.033;
  fmsurf    1.0;
  epsurf    0.0;
  fmoil     0.823;
  floil     0.295;
  epoil     3.827;
}

noFoam{}


