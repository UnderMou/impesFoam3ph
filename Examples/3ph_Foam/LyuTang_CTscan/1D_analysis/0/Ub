FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Ub;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];    // m/s

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        // type            fixedValue;
        // value           uniform (0 0 4.84716e-06);

        type            prescribedFracFlowVelocity;
        U               uniform (0 0 1.61572e-5);
        fractionalFlow  0.3;
        value           uniform (0 0 0);
    }

    outlet
    {
        // type            fixedValue;
        // value           $internalField;

        type            zeroGradient;

        // type            fixedInternalValue;
        // value           internalField;
    }

    emptyWalls
    {
        type            empty;
    }
}

