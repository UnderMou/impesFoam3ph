FoamFile
{
    format      ascii;
    class       surfaceScalarField;
    location    "0";
    object      Foil;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.238365;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }
    outlet
    {
        type            calculated;
        value           uniform 0;
    }
    emptyWalls
    {
        type            empty;
        value           nonuniform List<scalar> 0();
    }
}


