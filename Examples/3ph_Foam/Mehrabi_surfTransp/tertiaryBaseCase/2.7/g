FoamFile
{
    format      ascii;
    class       surfaceVectorField;
    location    "2.7";
    object      g;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    outlet
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    emptyWalls
    {
        type            empty;
        value           nonuniform List<vector> 0();
    }
}


