FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Sa;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform {{Sainit}};

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform {{Sainj}};
    }

    outlet
    {
        type            zeroGradient;
    }

    emptyWalls
    {
        type            empty;
    }
}

