FoamFile
{
    format      ascii;
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

4
(
    inlet
    {
        type            patch;
        nFaces          50;
        startFace       9850;
    }
    outlet
    {
        type            patch;
        nFaces          50;
        startFace       9900;
    }
    walls
    {
        type            wall;
        inGroups        List<word> 1(wall);
        nFaces          200;
        startFace       9950;
    }
    emptyWalls
    {
        type            empty;
        inGroups        List<word> 1(empty);
        nFaces          10000;
        startFace       10150;
    }
)

